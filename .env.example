# Local development. In production, use your real HTTPS origin.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/jr.sqlite
BACKUP_DIR=./backups
# Optional: Supabase Transaction Pooler (port 6543). When set, the app uses Postgres instead of the local SQLite file.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Optional direct connection for schema/setup if the pooler rejects DDL.
# DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Passwords are created interactively with npm run setup, not stored here.
